# ── Local Agent Rules & Config ───────────────────────────────────────────────
.agents/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── venv ───────────────────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/

# ── tools/ — git-installed binaries (regenerated by agent on demand) ───────
tools/*
!tools/.gitkeep
!tools/manifest.json

# ── wordlists — SecLists is huge, api lists are seeded at runtime ──────────
wordlists/SecLists/
wordlists/api_folders.txt
wordlists/api_files.txt
wordlists/api_params.txt
!wordlists/.gitkeep

# ── logs ───────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── secrets ────────────────────────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ── OS cruft ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml

# ── scan output (if you ever run scans inside repo — should not happen) ───
scans/
*.log
!live.log

# ── misc ───────────────────────────────────────────────────────────────────
*.bak
*.orig
*.rej
