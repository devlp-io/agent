# ── Model config ───────────────────────────────────────────────────────────
# Default: local ollama (dolphin3)
# AG_MODEL=dolphin3
# AG_BASE=http://localhost:11434/v1
# AG_KEY=ollama

# DeepSeek (recommended): set your key here
# AG_MODEL=deepseek-chat
# AG_BASE=https://api.deepseek.com/v1
# AG_KEY=sk-your-key-here

# Gemini
# AG_MODEL=gemini-1.5-flash
# AG_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# AG_KEY=your-gemini-key

# ── Fallback chain (model@base|model@base) ─────────────────────────────────
# AG_FALLBACKS=deepseek-chat@https://api.deepseek.com/v1|gemini-1.5-flash@https://generativelanguage.googleapis.com/v1beta/openai

# ── Runtime ────────────────────────────────────────────────────────────────
# AG_MAX_TURNS=300
# AG_CMD_TIMEOUT=1800
# AG_CURL_TIMEOUT=25
# AG_SCAN_ROOT=~/scans
# AG_CTX_MAX=40
# AG_CTX_KEEP=16
# AG_VERBOSE=0

# ── Proxy (tor, burp, mitmproxy) ──────────────────────────────────────────
# AG_PROXY=socks5://127.0.0.1:9050
# --- agent v8 additions ---
# model backend
AG_MODEL=deepseek-chat
AG_BASE=https://api.deepseek.com/v1
AG_KEY=
# DEEPSEEK_KEY is an alias for AG_KEY

# run tuning
AG_MAX_TURNS=500
AG_CMD_TIMEOUT=7200
AG_CURL_TIMEOUT=25
AG_CTX_MAX=60
AG_CTX_KEEP=24
AG_MAX_REFUSALS=9999

# proxy (single for shell, list for pool)
AG_PROXY=
AG_PROXIES=socks5://127.0.0.1:9050,http://proxy2:8080

# browser (optional — pkg install chromium first)
AG_BROWSER=0

# budget caps (0 = unlimited)
AG_MAX_REQ=0
AG_MAX_TIME=0
AG_MAX_BYTES=0

# evidence sealing key (HMAC for manifest)
AG_SEAL_KEY=
