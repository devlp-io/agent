#!/usr/bin/env bash
# SOM-SCAN launcher for Linux, macOS, WSL2 Ubuntu, and Android Termux.
# First run bootstraps a local virtualenv + requirements + core toolkits,
# then launches the CLI. `somscan gui` starts the web console in the background.
set -u

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

export PATH="$HOME/go/bin:$HOME/.local/bin:$DIR/tools:/usr/local/go/bin:/usr/local/bin:$PATH"
export PYTHONUNBUFFERED=1
export PYTHONIOENCODING=utf-8

pick_python() {
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
            command -v "$c"
            return 0
        fi
    done
    return 1
}

VENV=""
for v in "$DIR/.venv_linux" "$DIR/.venv" "$DIR/venv"; do
    if [ -x "$v/bin/python" ]; then VENV="$v"; break; fi
done

if [ -z "$VENV" ]; then
    BASE_PY="$(pick_python)" || {
        echo "[somscan] Python 3.10+ is required." >&2
        echo "  Ubuntu/WSL: sudo apt install -y python3 python3-venv python3-pip" >&2
        echo "  Termux:     pkg install -y python" >&2
        exit 1
    }
    echo "[somscan] first run — creating environment (one time)…"
    if "$BASE_PY" -m venv "$DIR/.venv" >/dev/null 2>&1; then
        VENV="$DIR/.venv"
    else
        echo "[somscan] python3-venv missing; installing requirements with system Python."
        "$BASE_PY" -m pip install --user -r "$DIR/requirements.txt" || {
            echo "[somscan] dependency install failed. Run ./bootstrap.sh." >&2
            exit 1
        }
        VENV=""
    fi
    if [ -n "$VENV" ]; then
        "$VENV/bin/python" -m pip install --upgrade pip setuptools wheel >/dev/null 2>&1 || true
        if ! "$VENV/bin/python" -m pip install -r "$DIR/requirements.txt"; then
            echo "[somscan] dependency install failed. Run ./bootstrap.sh." >&2
            exit 1
        fi
    fi
    touch "$DIR/.bootstrap_done" 2>/dev/null || true
    if [ "${SOMSCAN_SKIP_TOOLKITS:-0}" != "1" ] && [ -f "$DIR/installer.py" ]; then
        echo "[somscan] installing core toolkits (first run, this can take a few minutes)…"
        TOOL_PY="$BASE_PY"
        [ -n "$VENV" ] && TOOL_PY="$VENV/bin/python"
        ( cd "$DIR" && "$TOOL_PY" "$DIR/installer.py" preinstall core ) || true
    fi
fi

if [ -n "$VENV" ]; then
    PY="$VENV/bin/python"
else
    PY="$(pick_python)" || { echo "[somscan] Python 3.10+ not found." >&2; exit 1; }
fi

exec "$PY" "$DIR/somscan.py" "$@"
