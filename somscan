#!/usr/bin/env bash
# SOM-SCAN launcher for Linux, macOS, WSL2 Ubuntu, and Android Termux.
# First run opens the guided setup, then launches the CLI.
set -u

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

export PATH="$HOME/go/bin:$HOME/.local/bin:$DIR/tools:/usr/local/go/bin:/usr/local/bin:$PATH"
export PYTHONUNBUFFERED=1
export PYTHONIOENCODING=utf-8

pick_python() {
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
            command -v "$c"
            return 0
        fi
    done
    return 1
}

find_venv() {
    for v in "$DIR/.venv" "$DIR/.venv_linux" "$DIR/venv"; do
        if [ -x "$v/bin/python" ]; then
            echo "$v"
            return 0
        fi
    done
    return 1
}

SYS_PY="$(pick_python)" || {
    echo "[somscan] Python 3.10+ is required." >&2
    echo "  Ubuntu/WSL: sudo apt install -y python3 python3-venv python3-pip" >&2
    echo "  Termux:     pkg install -y python" >&2
    echo "  macOS:      brew install python" >&2
    exit 1
}

# Explicit setup command always runs the guided installer with system Python.
if [ "${1:-}" = "setup" ] || [ "${1:-}" = "install" ]; then
    shift
    exec "$SYS_PY" "$DIR/setup_tui.py" "$@"
fi

VENV="$(find_venv || true)"
PY=""
if [ -n "$VENV" ]; then
    PY="$VENV/bin/python"
fi

need_setup() {
    local py="$1"
    local want_web="${2:-0}"
    [ -x "$py" ] || return 0
    "$py" -c "import rich, textual, openai, httpx, dotenv, requests" >/dev/null 2>&1 || return 0
    if [ "$want_web" = "1" ]; then
        "$py" -c "import pydantic, fastapi, uvicorn, multipart" >/dev/null 2>&1 || return 0
    fi
    return 1
}

WANT_WEB=0
[ "${1:-}" = "gui" ] && WANT_WEB=1

if need_setup "$PY" "$WANT_WEB"; then
    echo "[somscan] environment incomplete — starting guided setup…"
    SETUP_ARGS=(--auto)
    [ "${SOMSCAN_SKIP_TOOLKITS:-0}" = "1" ] && SETUP_ARGS+=(--no-toolkits)
    if ! "$SYS_PY" "$DIR/setup_tui.py" "${SETUP_ARGS[@]}"; then
        echo "[somscan] setup failed. Run: ./somscan setup" >&2
        exit 1
    fi
    VENV="$(find_venv || true)"
    PY=""
    [ -n "$VENV" ] && PY="$VENV/bin/python"
fi

if [ -z "$PY" ]; then
    echo "[somscan] no usable environment. Run: ./somscan setup" >&2
    exit 1
fi
if need_setup "$PY" "$WANT_WEB"; then
    echo "[somscan] environment is still incomplete. Run: ./somscan setup" >&2
    exit 1
fi

exec "$PY" "$DIR/somscan.py" "$@"
